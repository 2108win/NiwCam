<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App keys shared by both builds: xtool (xtool.yml infoPath) and Xcode (project.yml INFOPLIST_FILE).
     Bundle id, version and executable keys are added by the build tool. -->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>NiwCam</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <!-- iPhone only (App Store, 2026-11-09): an iPad runs it in iPhone mode. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Keychain group shared with the screen-broadcast extension (Store.swift); Xcode expands it,
         the xtool build leaves it as is and Store then ignores it. -->
    <key>CamStudioKeychainGroup</key>
    <string>$(AppIdentifierPrefix)vn.camstudio.shared</string>
    <key>NSCameraUsageDescription</key>
    <string>NiwCam gửi hình camera sang máy tính để dùng làm webcam.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>NiwCam có thể gửi âm thanh sang máy tính.</string>
    <!-- Without these two, Bonjour advertising fails silently (docs/protocol.md 1). -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>NiwCam cần mạng cục bộ để máy tính trong nhà tìm và kết nối tới điện thoại.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_camstudio._tcp</string>
    </array>
    <key>UIRequiresPersistentWiFi</key>
    <true/>
    <!-- No UIBackgroundModes voip (removed 2026-11-09 for App Review, guideline 2.5.4: no VoIP
         calls here). With it back, iOS 18+ allows multitasking camera access and the camera keeps
         streaming in a Picture in Picture window after the person leaves the app
         (BackgroundCamera.swift); without it that switch is hidden. -->
    <!-- Export compliance, so App Store Connect does not ask for every build: the link to the PC
         is encrypted only with Apple's CryptoKit (P-256, AES-GCM, SHA-256/HMAC; HKDF is written
         on top of CryptoKit's HMAC), no algorithm of our own. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
